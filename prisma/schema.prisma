generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (Better Auth) ───────────────────────────────────────────────────────

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String    @map("providerAccountId")
  providerId            String    @map("provider")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String   @default("")
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  openaiVectorStoreId String? @map("openai_vector_store_id")

  accounts          Account[]
  sessions          Session[]
  interviews        Interview[]        @relation("UserInterviews")
  interviewSessions InterviewSession[] @relation("UserInterviewSessions")
  documents         Document[]         @relation("UserDocuments")
  conversations     ChatConversation[] @relation("UserChatConversations")
  profilePrep       ProfilePrep?

  @@map("users")
}

// ─── Interviews ───────────────────────────────────────────────────────────────

model Interview {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation("UserInterviews", fields: [userId], references: [id], onDelete: Cascade)
  name        String
  companyName String?
  jobTitle    String?
  scheduledAt DateTime?
  notes       String?            @db.Text
  /// Documents the answer coach reads during this interview (CV, JD, notes…)
  documentIds String[]           @default([]) @map("document_ids")
  sessions    InterviewSession[]
  prep        InterviewPrep?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@map("interviews")
}

model InterviewSession {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("UserInterviewSessions", fields: [userId], references: [id], onDelete: Cascade)
  /// "in_progress" | "completed"
  status      String    @default("in_progress")
  /// Array of { role: "interviewer" | "candidate", text: string, at: ISO string }
  transcript  Json?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([interviewId])
  @@index([userId])
  @@map("interview_sessions")
}

// ─── Prep packs (lib/prep) ────────────────────────────────────────────────────
// Digested before the interview by a strong model, reviewed by the user;
// the live coach reads them. `content` follows lib/prep/schema.ts.

model ProfilePrep {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "pending" | "ready" | "failed" ("stale" is computed from sourceHash)
  status     String    @default("pending")
  sourceHash String?   @map("source_hash")
  content    Json?
  error      String?   @db.Text
  startedAt  DateTime? @map("started_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("profile_preps")
}

model InterviewPrep {
  id          String    @id @default(cuid())
  interviewId String    @unique
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  status      String    @default("pending")
  sourceHash  String?   @map("source_hash")
  content     Json?
  error       String?   @db.Text
  startedAt   DateTime? @map("started_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("interview_preps")
}

// ─── Documents ────────────────────────────────────────────────────────────────

model Document {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  title        String
  type         DocumentType
  content      String       @db.Text
  openaiFileId String?      @map("openai_file_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([userId])
  @@map("documents")
}

// ─── Chat ─────────────────────────────────────────────────────────────────────

model ChatConversation {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation("UserChatConversations", fields: [userId], references: [id], onDelete: Cascade)
  title              String
  documentIds        String[]
  previousResponseId String?       @map("previous_response_id")
  messages           ChatMessage[]
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String           @db.Text
  sources        Json[]
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("chat_messages")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum DocumentType {
  RESUME
  COVER_LETTER
  PORTFOLIO
  JOB_DESCRIPTION
  NOTES
  PROJECT_DOCUMENTATION
}

enum MessageRole {
  user
  assistant
  system
}
