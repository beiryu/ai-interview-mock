generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (Better Auth) ───────────────────────────────────────────────────────

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String    @map("providerAccountId")
  providerId            String    @map("provider")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String   @default("")
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  accounts          Account[]
  sessions          Session[]
  jobs              Job[]              @relation("UserJobs")
  interviewSessions InterviewSession[] @relation("UserInterviewSessions")
  cvs               Cv[]               @relation("UserCvs")
  conversations     ChatConversation[] @relation("UserChatConversations")

  @@map("users")
}

// ─── Interviews ───────────────────────────────────────────────────────────────

/// Where a job application stands
enum JobStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  ARCHIVED
}

/// A job you might apply to: its description, the CV you send for it and,
/// once you're invited, the interview (one per job; sessions are its runs).
model Job {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation("UserJobs", fields: [userId], references: [id], onDelete: Cascade)
  company     String             @default("")
  title       String             @default("")
  /// The job description, as pasted or extracted
  jdText      String             @default("") @map("jd_text") @db.Text
  sourceUrl   String?            @map("source_url")
  status      JobStatus          @default(SAVED)
  /// When the interview is (null: not invited yet)
  scheduledAt DateTime?
  notes       String?            @db.Text
  sessions    InterviewSession[]
  prep        JobPrep?
  /// The CV made for this job (refined from one of yours, or generated)
  cv          Cv?                @relation("JobCv")
  /// Personal answers for this job (salary, why this company, notice…)
  answers     Json?
  chat        ChatConversation?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@map("jobs")
}

model InterviewSession {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("UserInterviewSessions", fields: [userId], references: [id], onDelete: Cascade)
  /// "in_progress" | "completed"
  status      String    @default("in_progress")
  /// Array of { role: "interviewer" | "candidate", text: string, at: ISO string }
  transcript  Json?
  /// What happened so far (lib/ai/ledger.ts), read by the coach
  ledger      Json?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([jobId])
  @@index([userId])
  @@map("interview_sessions")
}

// ─── Prep packs (lib/prep) ────────────────────────────────────────────────────
// Digested before the interview by a strong model, reviewed by the user;
// the live coach reads them. `content` follows lib/prep/schema.ts.

model JobPrep {
  id          String    @id @default(cuid())
  jobId       String    @unique
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status      String    @default("pending")
  sourceHash  String?   @map("source_hash")
  content     Json?
  error       String?   @db.Text
  startedAt   DateTime? @map("started_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("job_preps")
}

// A CV tailored to one interview's job (lib/cv), built from the profile prep
// and the JD; `content` follows lib/cv/schema.ts.
// ─── Documents ────────────────────────────────────────────────────────────────

// ─── Chat ─────────────────────────────────────────────────────────────────────

model ChatConversation {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("UserChatConversations", fields: [userId], references: [id], onDelete: Cascade)
  /// The job whose interview chat this is (null: legacy Document Chat history)
  jobId       String?       @unique @map("job_id")
  job         Job?          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title       String        @default("")
  messages    ChatMessage[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String           @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("chat_messages")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum MessageRole {
  user
  assistant
  system
}

/// How a CV came to be
enum CvOrigin {
  /// You uploaded it (your real CV)
  UPLOADED
  /// Rewritten from another CV for one job's description
  REFINED
  /// Written from a job description alone: a fictional practice persona
  GENERATED
}

/// A CV. Uploaded ones are yours; refined and generated ones are made for a
/// job (jobId) and remember the CV they started from (basedOn).
model Cv {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("UserCvs", fields: [userId], references: [id], onDelete: Cascade)
  title      String
  origin     CvOrigin
  basedOnId  String?   @map("based_on_id")
  basedOn    Cv?       @relation("CvBasedOn", fields: [basedOnId], references: [id], onDelete: SetNull)
  derived    Cv[]      @relation("CvBasedOn")
  jobId      String?   @unique @map("job_id")
  job        Job?      @relation("JobCv", fields: [jobId], references: [id], onDelete: Cascade)
  /// The uploaded text (UPLOADED only): the truth refined CVs are checked against
  rawText    String?   @map("raw_text") @db.Text
  /// "pending" | "ready" | "failed" ("stale" is computed from sourceHash)
  status     String    @default("pending")
  sourceHash String?   @map("source_hash")
  /// lib/cv/schema.ts CvContentSchema
  content    Json?
  error      String?   @db.Text
  startedAt  DateTime? @map("started_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("cvs")
}
